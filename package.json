{
  "name": "peer-term",
  "version": "1.0.0",
  "description": "Share your terminal with anyone using a 6-digit code. End-to-end encrypted.",
  "type": "module",
  "private": true,
  "workspaces": [
    "relay",
    "host"
  ],
  "scripts": {
    "start": "npm run relay",
    "relay": "cd relay && npm start",
    "relay:dev": "cd relay && npm run dev",
    "host": "cd host && npm start",
    "test": "node --test \"host/tests/**/*.test.js\" \"relay/tests/**/*.test.js\" \"client/tests/**/*.test.js\""
  },
  "author": "",
  "license": "MIT"
}
